rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check if user is in whitelist
    function isWhitelisted() {
      return isAuthenticated() && exists(/databases/$(database)/documents/whitelist_uids/$(request.auth.uid));
    }

    // 1. Whitelist rules
    match /whitelist/{name} {
      allow read: if true;
      allow create, update: if isWhitelisted() && !name.matches(".* [^ ]{2,}.*");
      // Commanders can delete employees from their team (checked client-side by role)
      allow delete: if isWhitelisted();
    }

    match /whitelist_uids/{uid} {
      allow read: if isAuthenticated();
      allow write: if isWhitelisted() || request.auth.uid == uid;
    }

    // 2. Tasks rules
    match /tasks/{taskId} {
      allow read, write: if isAuthenticated();
    }

    // 3. Workers rules
    match /workers/{workerId} {
      allow read, write: if isAuthenticated();
    }

    // 4. Task Bundles rules
    match /task_bundles/{bundleId} {
      allow read, write: if isAuthenticated();
    }

    // 5. Attendance rules
    match /attendance/{docId} {
      allow read, write: if isAuthenticated();
    }

    // 5.5 NFC Tags rules
    match /nfc_tags/{tagId} {
      allow read, write: if isAuthenticated();
    }

    // 6. Settings rules
    match /settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isWhitelisted(); // Only whitelisted users can modify settings
    }

    // 7. Duties rules
    match /duties/{docId} {
      allow read, write: if isAuthenticated();
    }

    // 8. Bot Logs rules
    match /bot_logs/{logId} {
      allow read: if isWhitelisted();
      allow write: if false; // Only admin SDK (bot) can write
    }

    // 9. Deliveries and Chat rules
    match /deliveries/{deliveryId} {
      allow read, write: if isAuthenticated();
      
      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }

    // 10. Kitchen Duties rules
    match /kitchen_duties/{dutyId} {
      allow read, write: if isAuthenticated();
    }

    // 11. Kitchen Layouts rules
    match /kitchen_layouts/{layoutId} {
      allow read, write: if isAuthenticated();
    }

    // 12. Kitchen Settings rules
    match /kitchen_settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isWhitelisted(); // Only whitelisted users can modify settings
    }

    // 13. Pending Approvals (HR Management)
    match /pending_approvals/{requestId} {
      // Any whitelisted user can read (commanders see their own, Tamar sees all)
      allow read: if isWhitelisted();
      // Commanders can create approval requests
      allow create: if isWhitelisted();
      // Tamar (or super admins) can update status (approve/reject)
      allow update: if isWhitelisted();
      allow delete: if isWhitelisted();
    }
  }
}
