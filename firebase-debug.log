[debug] [2026-09-08T12:49:13.908Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/tasks-b9e9e/rulesets {"name":"projects/tasks-b9e9e/rulesets/b6aef6ca-2726-45b6-9fab-6c0c3da50dc4","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // Helper: Check if user is logged in\n    function isAuthenticated() {\n      return request.auth != null;\n    }\n\n    // 1. Whitelist rules\n    match /whitelist/{name} {\n      allow read: if true;\n      allow create, update, delete: if isAuthenticated();\n    }\n\n    match /whitelist_uids/{uid} {\n      allow read, write: if isAuthenticated();\n    }\n\n    // 2. Tasks rules\n    match /tasks/{taskId} {\n      allow read, write: if isAuthenticated();\n    }\n\n    // 3. Workers rules\n    match /workers/{workerId} {\n      allow read, write: if isAuthenticated();\n    }\n\n    // 4. Task Bundles rules\n    match /task_bundles/{bundleId} {\n      allow read, write: if isAuthenticated();\n    }\n\n    // 5. Attendance rules\n    match /attendance/{docId} {\n      allow read, write: if isAuthenticated();\n    }\n\n    // 6. Settings rules\n    match /settings/{docId} {\n      allow read, write: if isAuthenticated();\n    }\n\n    // 7. Duties rules\n    match /duties/{docId} {\n      allow read, write: if isAuthenticated();\n    }\n\n    // 8. Bot Logs rules\n    match /bot_logs/{logId} {\n      allow read: if isAuthenticated();\n      allow write: if false; // Only admin SDK (bot) can write\n    }\n\n    // 9. Deliveries and Chat rules\n    match /deliveries/{deliveryId} {\n      allow read, write: if isAuthenticated();\n      \n      match /messages/{messageId} {\n        allow read, write: if isAuthenticated();\n      }\n    }\n\n    // 10. Kitchen Duties rules\n    match /kitchen_duties/{dutyId} {\n      allow read, write: if isAuthenticated();\n    }\n\n    // 11. Kitchen Layouts rules\n    match /kitchen_layouts/{layoutId} {\n      allow read, write: if isAuthenticated();\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-09-08T12:49:13.853519Z","metadata":{"services":["cloud.firestore"]}}
